# Vertex AI configuration for ADK and google-genai
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Strategic Model Routing identifiers (Flash for intake/coordinator, Pro for reasoning/exports)
JOURNAL_AGENT_MODEL=gemini-3.5-flash
JOURNAL_AGENT_PRO_MODEL=gemini-3.1-pro-preview

# Google Cloud Firestore, Cloud Storage, Secret Manager & Observability
FIRESTORE_DATABASE=(default)
MEDICAL_EXPORT_GCS_BUCKET=your-medical-exports-bucket
MEDICAL_EXPORT_BUCKET_SECRET_ID=journal-agent-export-bucket
ENABLE_CLOUD_TRACE=TRUE
